# Copy to .env (git-ignored). Real environment variables override these values.
# Works with any OpenAI-compatible chat API that supports tool calling.

# --- Local testing: Ollama (default) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:1.7b

# --- Other providers: replace the three lines above, e.g. ---
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1                          LLM_MODEL=gpt-4o-mini
# Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1                     LLM_MODEL=llama-3.3-70b-versatile
# Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash
# Claude:  LLM_BASE_URL=https://api.anthropic.com/v1/                      LLM_MODEL=claude-sonnet-5-5
# LLM_API_KEY=<your provider key>
