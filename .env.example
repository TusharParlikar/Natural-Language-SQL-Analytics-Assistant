# Copy to .env (git-ignored) and fill in your key. Real environment variables override these values.
# Works with any OpenAI-compatible chat API that supports tool calling.

# --- Groq (default; free key at https://console.groq.com/keys) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-120b

# --- Fully local: Ollama (no key; run `ollama pull qwen3:1.7b`) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:1.7b

# --- Other providers, e.g. ---
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1                                 LLM_MODEL=gpt-4o-mini
# Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash
# Claude:  LLM_BASE_URL=https://api.anthropic.com/v1/                             LLM_MODEL=claude-sonnet-5-5

# Seconds to wait for one LLM reply (raise for slow CPU-only models)
LLM_TIMEOUT=120

# Optional: password for the app's Modify switch (upload/edit/delete). Set it on a public deploy.
# MODIFY_PASSWORD=choose-a-password
